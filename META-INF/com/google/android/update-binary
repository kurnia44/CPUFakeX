#!/sbin/sh
umask 022
MODID=cpufakex
NZ="${NVBASE:-/data/adb}"
MODPATH="$NZ/modules/$MODID"
CFG="$NZ/$MODID"
ZIPFILE="$3"
[ -n "$ZIPFILE" ] || ZIPFILE="$2"
[ -f "$ZIPFILE" ] || { echo "! zip tidak ditemukan"; exit 1; }

mkdir -p "$MODPATH" "$CFG" 2>/dev/null
UNZIP=$(command -v unzip 2>/dev/null || echo "busybox unzip")
$UNZIP -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >/dev/null 2>&1
[ -f "$MODPATH/module.prop" ] || { echo "! ekstraksi gagal"; exit 1; }

chmod 755 "$MODPATH"/*.sh 2>/dev/null
chmod 755 "$MODPATH"/bin/*.sh 2>/dev/null
chmod 644 "$MODPATH/module.prop" "$MODPATH/defaults.conf" "$MODPATH/system.prop" 2>/dev/null
chmod 644 "$MODPATH"/webroot/* 2>/dev/null
chmod -R 755 "$CFG" 2>/dev/null

[ -s "$CFG/config.conf" ] || cp -f "$MODPATH/defaults.conf" "$CFG/config.conf" 2>/dev/null
chmod 600 "$CFG/config.conf" 2>/dev/null

# migrasi v1.2: lapisan cpufreq dimatikan (cosmetic-only, bisa dinyalakan dari WebUI)
# migrasi v1.3: cpufreq dinyalakan lagi (v1.2 memaksa 0 — itu bukan pilihan user)
if ! grep -q '^migrated_v13=1' "$CFG/config.conf" 2>/dev/null; then
  awk 'BEGIN{d=0}
    index($0,"spoof_cpufreq=")==1{print "spoof_cpufreq=1"; d=1; next}
    {print}
    END{if(!d) print "spoof_cpufreq=1"; print "migrated_v13=1"}' \
    "$CFG/config.conf" > "$CFG/config.conf.n3" 2>/dev/null && \
    mv "$CFG/config.conf.n3" "$CFG/config.conf"
  chmod 600 "$CFG/config.conf" 2>/dev/null
fi

if ! grep -q '^migrated_v12=1' "$CFG/config.conf" 2>/dev/null; then
  awk 'BEGIN{d=0}
    index($0,"spoof_cpufreq=")==1{print "spoof_cpufreq=0"; d=1; next}
    {print}
    END{if(!d) print "spoof_cpufreq=0"; print "migrated_v12=1"}' \
    "$CFG/config.conf" > "$CFG/config.conf.new" 2>/dev/null && \
    mv "$CFG/config.conf.new" "$CFG/config.conf"
  chmod 600 "$CFG/config.conf" 2>/dev/null
fi

MODPATH="$MODPATH" sh "$MODPATH/customize.sh" 2>/dev/null
exit 0
